# ============================================================================
# DALA VIRTUAL CITY - ENVIRONMENT VARIABLES & SECRETS REFERENCE
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CORE PLATFORM (Automatically Managed in AI Studio)
# ----------------------------------------------------------------------------
# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Injected by AI Studio if using server-side Gemini endpoints.
GEMINI_API_KEY="MY_GEMINI_API_KEY"


# ----------------------------------------------------------------------------
# 2. DATABASE & BACKEND AUTH (Supabase / PostgreSQL)
# Required when connecting the database migration schema to live Supabase backend.
# ----------------------------------------------------------------------------
# VITE_SUPABASE_URL: Your Supabase Project API URL (Dashboard -> Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public API key for client-side queries (enforces RLS)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_SERVICE_ROLE_KEY: Private admin key for server-side operations only.
# (CRITICAL: Keep in Secrets panel only; never expose in VITE_ client builds)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# DATABASE_URL: Direct PostgreSQL connection string (for migrations and ORMs)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"


# ----------------------------------------------------------------------------
# 3. MOBILE MONEY GATEWAY (Safaricom Daraja API - Kenya M-Pesa STK Push)
# Required for live M-Pesa rent collections & marketplace checkouts.
# Obtained from developer.safaricom.co.ke
# ----------------------------------------------------------------------------
# MPESA_ENVIRONMENT: "sandbox" for development/testing, "production" for live
MPESA_ENVIRONMENT="sandbox"

# MPESA_CONSUMER_KEY: Daraja App Consumer Key
MPESA_CONSUMER_KEY="your_mpesa_consumer_key"

# MPESA_CONSUMER_SECRET: Daraja App Consumer Secret
MPESA_CONSUMER_SECRET="your_mpesa_consumer_secret"

# MPESA_SHORTCODE: Business Paybill or Till Number (Sandbox test: 174379)
MPESA_SHORTCODE="174379"

# MPESA_PASSKEY: Lipa Na M-Pesa Online (LNM) passkey for generating STK password
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"

# MPESA_CALLBACK_URL: Webhook URL where Safaricom sends transaction status
MPESA_CALLBACK_URL="https://your-domain.com/api/mpesa/callback"
